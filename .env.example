# ------------------------------------------------------------------------------
# 1. Hostinger Webmail SMTP Configuration (Active)
# ------------------------------------------------------------------------------
# Hostinger SMTP Server details (Standard hPanel settings):
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true

# Enter your full Hostinger email address and password below:
SMTP_USER=notifications@yourdomain.com
SMTP_PASS=your_hostinger_email_password

# Sender display name & email (must match your Hostinger mailbox or domain):
FROM_EMAIL="yfy.ai Compliance Team <notifications@yourdomain.com>"

# Internal sales team mailbox to receive instant demo lead alerts:
SALES_EMAIL=sk@finnovo.io

